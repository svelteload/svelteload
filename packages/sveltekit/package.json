{
  "name": "@svelteload/sveltekit",
  "version": "0.0.1",
  "private": true,
  "description": "Shared SvelteKit code consumed by every svelteload site's apps/web: server helpers, search, components, utils.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.svelte": "./src/*.svelte"
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@google-cloud/recaptcha-enterprise": "^6",
    "@payloadcms/db-postgres": "^3",
    "@payloadcms/richtext-lexical": "^3",
    "@sendgrid/mail": "^8",
    "@sveltejs/kit": "^2",
    "@svelteload/payload": "*",
    "payload": "^3",
    "payload-config": "*",
    "project-meta": "*"
  },
  "devDependencies": {
    "@google-cloud/recaptcha-enterprise": "^6.4.0",
    "@payloadcms/db-postgres": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@sendgrid/mail": "^8.1.6",
    "@sveltejs/kit": "^2.57.1",
    "@svelteload/payload": "workspace:*",
    "payload": "3.83.0",
    "payload-config": "workspace:*",
    "project-meta": "workspace:*",
    "typescript": "^6.0.3"
  }
}
